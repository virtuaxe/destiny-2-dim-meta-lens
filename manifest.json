{
  "manifest_version": 3,
  "name": "Destiny DIM Meta Finder",
  "version": "0.19.0",
  "description": "Overlays TheAegisRelic PVE endgame grades and light.gg popularity ranks onto weapons, and armor set-bonus grades onto armor, in Destiny Item Manager. Adds a rank-aware filter panel.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://app.destinyitemmanager.com/*"],
      "js": ["ranks.js", "exotics.js", "tiers.js", "armor.js", "content.js", "panel.js"],
      "css": ["styles.css", "panel.css"],
      "run_at": "document_idle"
    }
  ]
}
